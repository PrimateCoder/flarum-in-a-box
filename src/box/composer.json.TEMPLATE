{
    "name": "pianotell/flarum-in-a-box",
    "description": "All-in-one Flarum 1.8 demo container with 40+ extensions, MariaDB, and nginx",
    "type": "project",
    "keywords": [
        "forum",
        "discussion",
        "flarum",
        "docker"
    ],
    "homepage": "https://github.com/PrimateCoder/flarum-in-a-box",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/PrimateCoder/flarum-in-a-box/issues",
        "source": "https://github.com/PrimateCoder/flarum-in-a-box"
    },
    "require": {
        "antoinefr/flarum-ext-bbcode-fa": "*",
        "flarum/approval": "*",
        "flarum/bbcode": "*",
        "flarum/core": "^1.8.19",
        "flarum/emoji": "*",
        "flarum/extension-manager": "^1.0",
        "flarum/flags": "*",
        "flarum/lang-english": "*",
        "flarum/likes": "*",
        "flarum/lock": "*",
        "flarum/markdown": "*",
        "flarum/mentions": "*",
        "flarum/nicknames": "*",
        "flarum/statistics": "*",
        "flarum/sticky": "*",
        "flarum/subscriptions": "*",
        "flarum/suspend": "*",
        "flarum/tags": "*",
        "fof/anti-spam": "*",
        "fof/best-answer": "*",
        "fof/byobu": "*",
        "fof/discussion-views": "*",
        "fof/drafts": "*",
        "fof/follow-tags": "*",
        "fof/formatting": "*",
        "fof/gamification": "*",
        "fof/ignore-users": "*",
        "fof/impersonate": "*",
        "fof/links": "*",
        "fof/merge-discussions": "*",
        "fof/moderator-notes": "*",
        "fof/move-posts": "*",
        "fof/oauth": "*",
        "fof/pages": "*",
        "fof/photoswipe": "*",
        "fof/polls": "*",
        "fof/reactions": "*",
        "fof/share-social": "*",
        "fof/sitemap": "*",
        "fof/split": "*",
        "fof/terms": "*",
        "fof/upload": "*",
        "fof/user-bio": "*",
        "fof/user-directory": "*",
        "ianm/log-viewer": "*",
        "justoverclock/flarum-ext-welcomebox": "*",
        "michaelbelgium/flarum-profile-views": "*",
        "pianotell/flarum-demo-auto-confirm": "*",
        "pianotell/flarum-ext-flamoji": "*",
        "rob006/flarum-ext-last-post-avatar": "*"
    },
    "_disabled-require": {
        "_comment": "Park here any extension that is temporarily incompatible with Flarum 1.x; move back into 'require' when a compatible release lands."
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "local-extensions/demo-auto-confirm",
            "options": {
                "symlink": false
            }
        }
    ],
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "flarum/extension-manager": true
        }
    }
}
